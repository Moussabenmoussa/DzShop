<div class="max-w-md mx-auto pb-20">

    <!-- 1. بطاقة الرصيد (بتصميم مضغوط للهاتف) -->
    <div class="bg-gray-900 rounded-2xl p-5 text-white shadow-lg mb-6 relative overflow-hidden border border-gray-800">
        <div class="flex justify-between items-start z-10 relative">
            <div>
                <p class="text-gray-400 text-xs mb-1">رصيدك الحالي</p>
                <h2 class="text-4xl font-bold text-yellow-400"><%= user.points %></h2>
            </div>
            <div class="bg-gray-800 px-3 py-1 rounded-full text-xs border border-gray-600">
                ⭐ جودة: <%= user.qualityScore %>/3
            </div>
        </div>
        <!-- زر المشاهدة (مدمج) -->
        <a href="/viewer" class="mt-4 block w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-center font-bold py-3 rounded-xl shadow-md active:scale-95 transition">
            ▶️ فتح المشاهد الآلي
        </a>
    </div>

    <!-- 2. نموذج إضافة فيديو (مبسط) -->
    <div class="bg-white rounded-2xl shadow-sm p-5 mb-6 border border-gray-100">
        <h3 class="font-bold text-gray-800 mb-4 flex items-center gap-2">
            <span class="bg-pink-100 text-pink-600 w-8 h-8 flex items-center justify-center rounded-full text-lg">+</span>
            أضف حملة جديدة
        </h3>
        
        <form action="/add-video" method="POST" class="space-y-3">
            <div>
                <input type="url" name="url" placeholder="رابط فيديو (TikTok/YouTube)" required 
                       class="w-full bg-gray-50 px-4 py-3 rounded-xl border border-gray-200 focus:border-pink-500 focus:ring-1 focus:ring-pink-500 outline-none text-sm">
            </div>

            <div class="flex gap-3">
                <input type="number" name="targetViews" placeholder="العدد" required 
                       class="w-1/3 bg-gray-50 px-4 py-3 rounded-xl border border-gray-200 focus:border-pink-500 outline-none text-sm text-center">
                
                <select name="duration" class="w-2/3 bg-gray-50 px-4 py-3 rounded-xl border border-gray-200 focus:border-pink-500 outline-none text-sm">
                    <option value="30">⏱️ 30ث (2 نقطة)</option>
                    <option value="60">🚀 60ث (4 نقاط)</option>
                </select>
            </div>

            <button type="submit" class="w-full bg-black text-white font-bold py-3 rounded-xl active:scale-95 transition shadow-lg">
                نشر الحملة 🚀
            </button>
        </form>
    </div>

    <!-- 3. قائمة الفيديوهات (بتصميم القائمة) -->
    <div>
        <h3 class="font-bold text-gray-800 mb-3 px-1">حملاتي النشطة</h3>
        <% if (videos && videos.length > 0) { %>
            <div class="space-y-3">
                <% videos.forEach(video => { %>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between">
                        <div class="flex-1 overflow-hidden">
                            <p class="text-xs text-gray-400 mb-1">فيديو (<%= video.duration %> ثانية)</p>
                            <!-- شريط تقدم -->
                            <div class="w-full h-2 bg-gray-100 rounded-full overflow-hidden">
                                <div class="h-full bg-green-500" style="width: <%= (video.completedViews / video.targetViews) * 100 %>%"></div>
                            </div>
                        </div>
                        <div class="mr-4 text-center min-w-[50px]">
                            <span class="block font-bold text-gray-800"><%= video.completedViews %></span>
                            <span class="text-xs text-gray-400">من <%= video.targetViews %></span>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-8 bg-gray-50 rounded-xl border border-dashed">
                <p class="text-gray-400 text-sm">لا توجد حملات</p>
            </div>
        <% } %>
    </div>
</div>
