



<div class="max-w-md mx-auto pb-20">

    <!-- 1. بطاقة الرصيد (بتصميم مضغوط للهاتف) -->
    <div class="bg-gray-900 rounded-2xl p-5 text-white shadow-lg mb-6 relative overflow-hidden border border-gray-800">
        <div class="flex justify-between items-start z-10 relative">
            <div>
                <p class="text-gray-400 text-xs mb-1">رصيدك الحالي</p>
                <h2 class="text-4xl font-bold text-yellow-400"><%= user.points %></h2>
            </div>
            <div class="bg-gray-800 px-3 py-1 rounded-full text-xs border border-gray-600">
                ⭐ جودة: <%= user.qualityScore %>/3
            </div>
        </div>
        <!-- زر المشاهدة (مدمج) -->
        <a href="/viewer" class="mt-4 block w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-center font-bold py-3 rounded-xl shadow-md active:scale-95 transition">
            ▶️ فتح المشاهد الآلي
        </a>
    </div>




<div class="bg-white rounded-3xl shadow-xl p-6 mb-8 border border-gray-100 relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-pink-500 via-purple-500 to-blue-500"></div>

        <h3 class="font-bold text-gray-800 mb-6 flex items-center gap-3 text-xl">
            <span class="bg-gray-900 text-white w-10 h-10 flex items-center justify-center rounded-xl shadow-lg">🚀</span>
            إنشاء حملة جديدة
        </h3>
        
        <form action="/add-video" method="POST" class="space-y-6" id="campaignForm">
            
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-3">اختر نوع المنصة:</label>
                <div class="grid grid-cols-2 gap-4">
                    <label class="cursor-pointer relative group">
                        <input type="radio" name="type" value="video" checked onchange="toggleFormMode('video')" class="peer sr-only">
                        <div class="p-4 rounded-2xl border-2 border-gray-100 bg-gray-50 hover:bg-white peer-checked:border-pink-500 peer-checked:bg-pink-50 peer-checked:shadow-lg transition-all text-center h-full">
                            <div class="text-3xl mb-2 grayscale group-hover:grayscale-0 peer-checked:grayscale-0 transition">📹</div>
                            <div class="font-bold text-gray-700 peer-checked:text-pink-600">فيديو TikTok/YouTube</div>
                            <div class="text-xs text-gray-400 mt-1">مشاهدات حقيقية</div>
                        </div>
                        <div class="absolute top-3 right-3 hidden peer-checked:block text-pink-500">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        </div>
                    </label>

                    <label class="cursor-pointer relative group">
                        <input type="radio" name="type" value="website" onchange="toggleFormMode('website')" class="peer sr-only">
                        <div class="p-4 rounded-2xl border-2 border-gray-100 bg-gray-50 hover:bg-white peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:shadow-lg transition-all text-center h-full">
                            <div class="text-3xl mb-2 grayscale group-hover:grayscale-0 peer-checked:grayscale-0 transition">🌐</div>
                            <div class="font-bold text-gray-700 peer-checked:text-blue-600">موقع ويب (Web Traffic)</div>
                            <div class="text-xs text-gray-400 mt-1">زيارات + SEO</div>
                        </div>
                         <div class="absolute top-3 right-3 hidden peer-checked:block text-blue-500">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        </div>
                    </label>
                </div>
            </div>

            <div id="websiteOptions" class="hidden animate-fade-in-down">
                <label class="block text-sm font-bold text-gray-700 mb-3">استراتيجية الزيارة:</label>
                <div class="grid grid-cols-2 gap-4 mb-4">
                    <label class="cursor-pointer">
                        <input type="radio" name="visitType" value="direct" checked onchange="toggleKeywordField(false)" class="peer sr-only">
                        <div class="p-3 rounded-xl border border-gray-200 peer-checked:bg-blue-600 peer-checked:text-white peer-checked:border-blue-600 transition flex items-center justify-center gap-2">
                            <span>⚡</span>
                            <span class="font-bold text-sm">مباشرة (Direct)</span>
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="visitType" value="search" onchange="toggleKeywordField(true)" class="peer sr-only">
                        <div class="p-3 rounded-xl border border-gray-200 peer-checked:bg-indigo-600 peer-checked:text-white peer-checked:border-indigo-600 transition flex items-center justify-center gap-2 relative">
                            <span>🔍</span>
                            <span class="font-bold text-sm">بحث جوجل (SEO)</span>
                            <span class="absolute -top-2 -left-2 bg-yellow-400 text-black text-[10px] font-bold px-2 py-0.5 rounded-full shadow-sm">Hot 🔥</span>
                        </div>
                    </label>
                </div>

                <div id="keywordField" class="hidden mt-3">
                    <label class="block text-xs font-bold text-gray-500 mb-1">الكلمة المفتاحية المستهدفة (Target Keyword)</label>
                    <input type="text" name="keyword" placeholder="مثال: أفضل عسل في الجزائر" 
                           class="w-full bg-indigo-50 px-4 py-3 rounded-xl border border-indigo-200 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none text-sm transition">
                    <p class="text-[10px] text-gray-400 mt-1">💡 سيقوم المستخدم بالبحث عن هذه الكلمة والضغط على موقعك لرفع ترتيبه.</p>
                </div>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">الرابط (URL)</label>
                <input type="url" name="url" placeholder="https://..." required 
                       class="w-full bg-gray-50 px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-800 focus:ring-1 focus:ring-gray-800 outline-none text-sm transition shadow-sm">
            </div>

            <div class="flex gap-4">
                <div class="w-1/3">
                    <label class="block text-sm font-bold text-gray-700 mb-1">العدد</label>
                    <input type="number" name="targetViews" placeholder="100" required 
                           class="w-full bg-gray-50 px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-800 outline-none text-sm text-center font-mono">
                </div>
                
                <div class="w-2/3">
                    <label class="block text-sm font-bold text-gray-700 mb-1">المدة (Dwell Time)</label>
                    <select name="duration" class="w-full bg-gray-50 px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-800 outline-none text-sm cursor-pointer">
                        <option value="30">⏱️ 30 ثانية (عادي)</option>
                        <option value="60">🚀 60 ثانية (+2 نقاط)</option>
                        <option value="90">💎 90 ثانية (+4 نقاط)</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="w-full bg-gray-900 hover:bg-black text-white font-bold py-4 rounded-xl active:scale-95 transition shadow-xl flex items-center justify-center gap-2">
                <span>🚀</span>
                <span>إطلاق الحملة الآن</span>
            </button>
        </form>
    </div>

    <script>
        function toggleFormMode(mode) {
            const websiteOptions = document.getElementById('websiteOptions');
            if (mode === 'website') {
                websiteOptions.classList.remove('hidden');
            } else {
                websiteOptions.classList.add('hidden');
            }
        }

        function toggleKeywordField(show) {
            const keywordField = document.getElementById('keywordField');
            if (show) {
                keywordField.classList.remove('hidden');
            } else {
                keywordField.classList.add('hidden');
            }
        }
    </script>
