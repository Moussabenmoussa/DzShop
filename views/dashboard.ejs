<%- include('layout') %>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Sidebar: Start Viewing -->
    <div class="md:col-span-1">
        <div class="bg-white p-6 rounded-xl shadow-md text-center">
            <h2 class="text-xl font-bold mb-2">ابدأ التجميع</h2>
            <p class="text-gray-500 text-sm mb-4">شاهد فيديوهات الآخرين لتكسب النقاط</p>
            <a href="/view" target="_blank" class="block w-full bg-green-600 text-white py-4 rounded-xl font-bold text-xl hover:bg-green-700 shadow-lg animate-pulse">
                ▶️ فتح المشاهد الآلي
            </a>
        </div>
        
        <!-- Add Campaign Form -->
        <div class="bg-white p-6 rounded-xl shadow-md mt-6">
            <h3 class="font-bold border-b pb-2 mb-4">إضافة فيديو تيك توك</h3>
            <form action="/add-campaign" method="POST" class="space-y-3">
                <input type="url" name="url" placeholder="رابط الفيديو (TikTok URL)" required class="w-full p-2 border rounded">
                <div class="flex gap-2">
                    <input type="number" name="views" placeholder="العدد" required class="w-1/2 p-2 border rounded">
                    <div class="flex items-center w-1/2">
                        <input type="checkbox" name="mobileOnly" id="mo" class="mr-2">
                        <label for="mo" class="text-sm">موبايل فقط (2x)</label>
                    </div>
                </div>
                <button class="w-full bg-blue-600 text-white py-2 rounded font-bold">نشر الحملة</button>
            </form>
        </div>
    </div>

    <!-- Main: My Videos -->
    <div class="md:col-span-2 bg-white p-6 rounded-xl shadow-md">
        <h3 class="font-bold text-xl mb-4">فيديوهاتي النشطة</h3>
        <% if (videos.length === 0) { %>
            <p class="text-gray-400 text-center py-10">لم تضف أي فيديو بعد.</p>
        <% } else { %>
            <div class="space-y-4">
                <% videos.forEach(vid => { %>
                    <div class="border p-4 rounded-lg flex justify-between items-center <%= vid.active ? 'border-green-200 bg-green-50' : 'border-gray-200 bg-gray-50' %>">
                        <div>
                            <p class="font-bold text-sm truncate w-64"><%= vid.url %></p>
                            <div class="text-xs text-gray-500 mt-1">
                                مكتمل: <span class="font-bold"><%= vid.completedViews %></span> / <%= vid.targetViews %>
                            </div>
                        </div>
                        <span class="<%= vid.active ? 'text-green-600' : 'text-gray-400' %> font-bold text-sm">
                            <%= vid.active ? 'جاري العمل ⚡' : 'مكتمل ✅' %>
                        </span>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</div>
