
<div class="max-w-4xl mx-auto">

    <!-- 1. بطاقات الإحصائيات وزر المشاهدة -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        
        <!-- بطاقة الرصيد -->
        <div class="bg-gradient-to-br from-gray-900 to-black p-6 rounded-2xl shadow-xl text-white border border-gray-800 relative overflow-hidden">
            <div class="relative z-10">
                <p class="text-gray-400 text-sm mb-1">رصيدك الحالي</p>
                <h2 class="text-4xl font-bold text-yellow-400"><%= user.points %> <span class="text-sm text-gray-300">نقطة</span></h2>
                <div class="mt-4 flex gap-2">
                    <span class="bg-gray-800 px-3 py-1 rounded-full text-xs border border-gray-600">
                        جودة الحساب: <%= user.qualityScore %>/3 ⭐
                    </span>
                </div>
            </div>
            <!-- زخرفة خلفية -->
            <div class="absolute right-0 top-0 opacity-10 transform translate-x-4 -translate-y-4">
                <svg class="w-32 h-32" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/></svg>
            </div>
        </div>

        <!-- زر المشاهدة (الأهم) -->
        <div class="bg-white p-6 rounded-2xl shadow-xl border border-gray-100 flex flex-col justify-center items-center text-center">
            <h3 class="text-lg font-bold text-gray-800 mb-2">ابدأ بجمع النقاط الآن! 🚀</h3>
            <p class="text-sm text-gray-500 mb-4">شاهد فيديوهات الآخرين لتربح النقاط وترفع ترتيبك.</p>
            
            <a href="/viewer" target="_blank" class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold py-4 rounded-xl shadow-lg transform transition hover:scale-105 flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                فتح المشاهد الآلي
            </a>
        </div>
    </div>

    <!-- 2. نموذج إضافة حملة جديدة (المحدث) -->
    <div class="bg-white rounded-2xl shadow-xl p-6 mb-8 border border-gray-100">
        <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
            <span class="text-pink-500 text-2xl">+</span> أضف حملة جديدة
        </h2>
        
        <form action="/add-video" method="POST" class="space-y-4">
            
            <!-- رابط الفيديو -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">رابط الفيديو (TikTok / YouTube)</label>
                <input type="url" name="url" placeholder="https://www.tiktok.com/@user/video/..." required 
                       class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-pink-500 focus:border-pink-500 outline-none transition">
                <p class="text-xs text-gray-400 mt-1">💡 نصيحة: استخدم الرابط الطويل لضمان ظهور الفيديو.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- العدد المطلوب -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">عدد المشاهدات المطلوبة</label>
                    <input type="number" name="targetViews" min="10" placeholder="مثلاً: 100" required 
                           class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-pink-500 outline-none">
                </div>

                <!-- خيارات الوقت والسعر -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">مدة المشاهدة (التكلفة)</label>
                    <select name="duration" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-pink-500 outline-none bg-white">
                        <option value="30">⏱️ 30 ثانية (التكلفة: 2 نقطة)</option>
                        <option value="45">🔥 45 ثانية (التكلفة: 3 نقاط)</option>
                        <option value="60">🚀 60 ثانية (التكلفة: 4 نقاط)</option>
                        <option value="90">💎 90 ثانية (التكلفة: 6 نقاط)</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="w-full bg-black hover:bg-gray-800 text-white font-bold py-3 rounded-xl transition shadow-lg transform active:scale-95">
                🚀 إطلاق الحملة
            </button>
        </form>
    </div>

    <!-- 3. قائمة فيديوهاتي النشطة -->
    <div class="mb-12">
        <h2 class="text-xl font-bold text-gray-800 mb-4 border-b pb-2">فيديوهاتي النشطة 📊</h2>
        
        <% if (videos && videos.length > 0) { %>
            <div class="grid gap-4">
                <% videos.forEach(video => { %>
                    <div class="bg-white p-4 rounded-xl shadow border border-gray-100 flex justify-between items-center">
                        <div class="flex-1 min-w-0">
                            <p class="text-sm text-blue-600 truncate mb-1"><%= video.url %></p>
                            <div class="flex items-center gap-4 text-xs text-gray-500">
                                <span>⏱️ <%= video.duration %> ثانية</span>
                                <span>💰 تكلفة: <%= video.costPerView %></span>
                            </div>
                        </div>
                        
                        <div class="text-left pl-4">
                            <div class="text-xs text-gray-400 mb-1">التقدم</div>
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-lg <%= video.completedViews >= video.targetViews ? 'text-green-500' : 'text-gray-800' %>">
                                    <%= video.completedViews %>
                                </span>
                                <span class="text-gray-400">/ <%= video.targetViews %></span>
                            </div>
                            
                            <!-- شريط تقدم صغير -->
                            <div class="w-24 h-1.5 bg-gray-100 rounded-full mt-1 overflow-hidden">
                                <div class="h-full bg-pink-500" style="width: <%= (video.completedViews / video.targetViews) * 100 %>%"></div>
                            </div>
                        </div>

                        <% if (video.active) { %>
                            <span class="ml-4 w-3 h-3 bg-green-500 rounded-full animate-pulse" title="نشط"></span>
                        <% } else { %>
                            <span class="ml-4 w-3 h-3 bg-gray-400 rounded-full" title="مكتمل"></span>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-10 bg-gray-50 rounded-xl border border-dashed border-gray-300">
                <p class="text-gray-500">لا توجد حملات نشطة حالياً</p>
                <p class="text-sm text-gray-400">أضف فيديو في الأعلى لتبدأ</p>
            </div>
        <% } %>
    </div>

</div>
