<div class="max-w-md mx-auto pb-20">

    <div class="bg-gray-900 rounded-2xl p-5 text-white shadow-lg mb-6 relative overflow-hidden border border-gray-800">
        <div class="flex justify-between items-start z-10 relative">
            <div>
                <p class="text-gray-400 text-xs mb-1">رصيدك الحالي</p>
                <h2 class="text-4xl font-bold text-yellow-400"><%= user.points %></h2>
            </div>
            <div class="bg-gray-800 px-3 py-1 rounded-full text-xs border border-gray-600">
                ⭐ جودة: <%= user.qualityScore %>/3
            </div>
        </div>
        <div class="grid grid-cols-2 gap-4 mt-6">
            
            <a href="/viewer?mode=video" class="group relative overflow-hidden rounded-2xl bg-gray-900 p-4 transition-all hover:shadow-2xl border border-gray-800 hover:border-pink-500 block text-center">
                <div class="absolute right-0 top-0 h-16 w-16 translate-x-4 translate-y--4 transform rounded-full bg-pink-600 opacity-20 blur-xl group-hover:opacity-40"></div>
                <div class="relative z-10 flex flex-col items-center justify-center gap-2">
                    <div class="text-3xl mb-1 group-hover:scale-110 transition duration-300">📹</div>
                    <h3 class="font-bold text-white text-sm">مشاهدة فيديوهات</h3>
                    <p class="text-[10px] text-gray-400">TikTok & YouTube</p>
                    <span class="mt-2 text-xs bg-pink-600 text-white px-3 py-1 rounded-full shadow-lg">دخول</span>
                </div>
            </a>

            <a href="/viewer?mode=website" class="group relative overflow-hidden rounded-2xl bg-gray-900 p-4 transition-all hover:shadow-2xl border border-gray-800 hover:border-blue-500 block text-center">
                <div class="absolute left-0 top-0 h-16 w-16 translate-x--4 translate-y--4 transform rounded-full bg-blue-600 opacity-20 blur-xl group-hover:opacity-40"></div>
                <div class="relative z-10 flex flex-col items-center justify-center gap-2">
                    <div class="text-3xl mb-1 group-hover:scale-110 transition duration-300">🌐</div>
                    <h3 class="font-bold text-white text-sm">زيارة مواقع</h3>
                    <p class="text-[10px] text-gray-400">Google SEO & Web</p>
                    <span class="mt-2 text-xs bg-blue-600 text-white px-3 py-1 rounded-full shadow-lg">دخول</span>
                </div>
            </a>

        </div>
    </div>

    <div class="bg-gray-900 rounded-2xl border border-gray-800 shadow-xl overflow-hidden mb-8">
        <div class="bg-gray-950 px-5 py-4 border-b border-gray-800 flex justify-between items-center">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                </span>
                Live Traffic Stream (نشاط الشبكة)
            </h3>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-right text-xs text-gray-400">
                <thead class="bg-gray-950 text-[10px] uppercase font-medium text-gray-500">
                    <tr>
                        <th class="px-4 py-3">الهوية (الجهاز)</th>
                        <th class="px-4 py-3">المصدر</th>
                        <th class="px-4 py-3">الحالة</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-800">
                    <% if (typeof recentVisits !== 'undefined' && recentVisits.length > 0) { %>
                        <% recentVisits.forEach(visit => { %>
                        <tr class="hover:bg-gray-800/30 transition">
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-2">
                                    <span class="text-lg">
                                        <% if(visit.device.includes('Win')) { %> 💻 <% } 
                                           else if(visit.device.includes('iPhone') || visit.device.includes('iPad')) { %> 📱 <% } 
                                           else if(visit.device.includes('Android')) { %> 🤖 <% } 
                                           else { %> 🖥️ <% } %>
                                    </span>
                                    <div>
                                        <div class="text-white font-bold text-[10px]"><%= visit.device %></div>
                                        <div class="text-[9px] text-gray-500"><%= visit.browser %></div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-1">
                                    <span class="text-blue-500 font-bold">G</span>
                                    <span class="text-green-500 font-bold text-[10px]">Organic</span>
                                </div>
                            </td>
                            <td class="px-4 py-3">
                                <span class="text-green-400 text-[10px] bg-green-900/20 px-2 py-0.5 rounded border border-green-900/50">
                                    ✅ مكتملة
                                </span>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="3" class="px-4 py-6 text-center text-gray-600 text-xs">
                                جاري انتظار أول زيارة...
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        <div class="bg-gray-950 px-4 py-2 text-center text-[9px] text-gray-600 border-t border-gray-800">
            بيانات حقيقية من السيرفر - يتم تغيير الهوية مع كل زيارة 🛡️
        </div>
    </div>


    <div class="bg-white rounded-3xl shadow-xl p-6 mb-8 border border-gray-100 relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-pink-500 via-purple-500 to-blue-500"></div>

        <h3 class="font-bold text-gray-800 mb-6 flex items-center gap-3 text-xl">
            <span class="bg-gray-900 text-white w-10 h-10 flex items-center justify-center rounded-xl shadow-lg">🚀</span>
            إنشاء حملة جديدة
        </h3>
        
        <form action="/add-video" method="POST" class="space-y-6" id="campaignForm">
            
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-3">اختر نوع المنصة:</label>
                <div class="grid grid-cols-2 gap-4">
                    <label class="cursor-pointer relative group">
                        <input type="radio" name="type" value="video" checked onchange="toggleFormMode('video')" class="peer sr-only">
                        <div class="p-4 rounded-2xl border-2 border-gray-100 bg-gray-50 hover:bg-white peer-checked:border-pink-500 peer-checked:bg-pink-50 peer-checked:shadow-lg transition-all text-center h-full">
                            <div class="text-3xl mb-2 grayscale group-hover:grayscale-0 peer-checked:grayscale-0 transition">📹</div>
                            <div class="font-bold text-gray-700 peer-checked:text-pink-600">فيديو TikTok/YouTube</div>
                            <div class="text-xs text-gray-400 mt-1">مشاهدات حقيقية</div>
                        </div>
                        <div class="absolute top-3 right-3 hidden peer-checked:block text-pink-500">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        </div>
                    </label>

                    <label class="cursor-pointer relative group">
                        <input type="radio" name="type" value="website" onchange="toggleFormMode('website')" class="peer sr-only">
                        <div class="p-4 rounded-2xl border-2 border-gray-100 bg-gray-50 hover:bg-white peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:shadow-lg transition-all text-center h-full">
                            <div class="text-3xl mb-2 grayscale group-hover:grayscale-0 peer-checked:grayscale-0 transition">🌐</div>
                            <div class="font-bold text-gray-700 peer-checked:text-blue-600">موقع ويب (Web Traffic)</div>
                            <div class="text-xs text-gray-400 mt-1">زيارات + SEO</div>
                        </div>
                         <div class="absolute top-3 right-3 hidden peer-checked:block text-blue-500">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        </div>
                    </label>
                </div>
            </div>

            <div id="websiteOptions" class="hidden animate-fade-in-down">
                <label class="block text-sm font-bold text-gray-700 mb-3">استراتيجية الزيارة:</label>
                <div class="grid grid-cols-2 gap-4 mb-4">
                    <label class="cursor-pointer">
                        <input type="radio" name="visitType" value="direct" checked onchange="toggleKeywordField(false)" class="peer sr-only">
                        <div class="p-3 rounded-xl border border-gray-200 peer-checked:bg-blue-600 peer-checked:text-white peer-checked:border-blue-600 transition flex items-center justify-center gap-2">
                            <span>⚡</span>
                            <span class="font-bold text-sm">مباشرة (Direct)</span>
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="visitType" value="search" onchange="toggleKeywordField(true)" class="peer sr-only">
                        <div class="p-3 rounded-xl border border-gray-200 peer-checked:bg-indigo-600 peer-checked:text-white peer-checked:border-indigo-600 transition flex items-center justify-center gap-2 relative">
                            <span>🔍</span>
                            <span class="font-bold text-sm">بحث جوجل (SEO)</span>
                            <span class="absolute -top-2 -left-2 bg-yellow-400 text-black text-[10px] font-bold px-2 py-0.5 rounded-full shadow-sm">Hot 🔥</span>
                        </div>
                    </label>
                </div>

                <div id="keywordField" class="hidden mt-3">
                    <label class="block text-xs font-bold text-gray-500 mb-1">الكلمة المفتاحية المستهدفة (Target Keyword)</label>
                    <input type="text" name="keyword" placeholder="مثال: أفضل عسل في الجزائر" 
                           class="w-full bg-indigo-50 px-4 py-3 rounded-xl border border-indigo-200 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none text-sm transition">
                    <p class="text-[10px] text-gray-400 mt-1">💡 سيقوم المستخدم بالبحث عن هذه الكلمة والضغط على موقعك لرفع ترتيبه.</p>
                </div>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">الرابط (URL)</label>
                <input type="url" name="url" placeholder="https://..." required 
                       class="w-full bg-gray-50 px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-800 focus:ring-1 focus:ring-gray-800 outline-none text-sm transition shadow-sm">
            </div>

            <div class="flex gap-4">
                <div class="w-1/3">
                    <label class="block text-sm font-bold text-gray-700 mb-1">العدد</label>
                    <input type="number" name="targetViews" placeholder="100" required 
                           class="w-full bg-gray-50 px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-800 outline-none text-sm text-center font-mono">
                </div>
                
                <div class="w-2/3">
                    <label class="block text-sm font-bold text-gray-700 mb-1">المدة (Dwell Time)</label>
                    <select name="duration" class="w-full bg-gray-50 px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-800 outline-none text-sm cursor-pointer">
                        <option value="30">⏱️ 30 ثانية (عادي)</option>
                        <option value="60">🚀 60 ثانية (+2 نقاط)</option>
                        <option value="90">💎 90 ثانية (+4 نقاط)</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="w-full bg-gray-900 hover:bg-black text-white font-bold py-4 rounded-xl active:scale-95 transition shadow-xl flex items-center justify-center gap-2">
                <span>🚀</span>
                <span>إطلاق الحملة الآن</span>
            </button>
        </form>
    </div>

    <script>
        function toggleFormMode(mode) {
            const websiteOptions = document.getElementById('websiteOptions');
            if (mode === 'website') {
                websiteOptions.classList.remove('hidden');
            } else {
                websiteOptions.classList.add('hidden');
            }
        }

        function toggleKeywordField(show) {
            const keywordField = document.getElementById('keywordField');
            if (show) {
                keywordField.classList.remove('hidden');
            } else {
                keywordField.classList.add('hidden');
            }
        }
    </script>


<div class="mt-8">
        <div class="flex items-center justify-between mb-4 px-1">
            <h3 class="font-bold text-gray-800 text-lg flex items-center gap-2">
                <span class="w-2 h-6 bg-black rounded-full"></span>
                إدارة الحملات
            </h3>
            <span class="text-xs text-gray-400 bg-gray-100 px-3 py-1 rounded-full border border-gray-200">
                <%= videos.length %> حملة
            </span>
        </div>

        <% if (videos && videos.length > 0) { %>
            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-right">
                        <thead>
                            <tr class="bg-gray-50 border-b border-gray-100 text-gray-400 text-xs uppercase tracking-wider">
                                <th class="px-6 py-4 font-medium">النوع</th>
                                <th class="px-6 py-4 font-medium">الحالة</th>
                                <th class="px-6 py-4 font-medium">التقدم</th>
                                <th class="px-6 py-4 font-medium">التفاصيل</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            <% videos.forEach(video => { %>
                                <tr class="hover:bg-gray-50/50 transition duration-200 group">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-xl flex items-center justify-center text-lg shadow-sm
                                                <%= video.type === 'website' ? 'bg-blue-50 text-blue-600 border border-blue-100' : 'bg-pink-50 text-pink-600 border border-pink-100' %>">
                                                <%= video.type === 'website' ? '🌐' : '📹' %>
                                            </div>
                                            <div>
                                                <div class="font-bold text-gray-800 text-sm">
                                                    <%= video.type === 'website' ? 'زيارة موقع' : 'مشاهدة فيديو' %>
                                                </div>
                                                <div class="text-[10px] text-gray-400 font-mono">
                                                    <%= video.visitType === 'search' ? '🔍 SEO Search' : (video.duration + ' ثانية') %>
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="px-6 py-4">
                                        <% if (video.status === 'Pending') { %>
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-yellow-50 text-yellow-600 border border-yellow-100">
                                                <span class="w-1.5 h-1.5 rounded-full bg-yellow-500 animate-pulse"></span>
                                                قيد المراجعة
                                            </span>
                                        <% } else if (video.status === 'Approved' && video.active) { %>
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-600 border border-green-100">
                                                <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
                                                نشطة
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-500 border border-gray-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                                                <%= video.status || 'مكتملة' %>
                                            </span>
                                        <% } %>
                                    </td>

                                    <td class="px-6 py-4 min-w-[180px]">
                                        <div class="flex justify-between text-xs mb-1.5">
                                            <span class="font-bold text-gray-700"><%= video.completedViews %> مكتملة</span>
                                            <span class="text-gray-400">من <%= video.targetViews %></span>
                                        </div>
                                        <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden">
                                            <div class="bg-gradient-to-r <%= video.active ? 'from-gray-900 to-gray-700' : 'from-green-500 to-emerald-500' %> h-2.5 rounded-full transition-all duration-500"
                                                 style="width: <%= (video.completedViews / video.targetViews) * 100 %>%">
                                            </div>
                                        </div>
                                    </td>

                                    <td class="px-6 py-4">
                                        <a href="<%= video.url %>" target="_blank" class="text-xs font-bold text-indigo-500 hover:text-indigo-700 hover:underline truncate max-w-[150px] block" title="<%= video.url %>">
                                            <%= video.url %> ↗
                                        </a>
                                        <% if (video.keyword) { %>
                                            <div class="text-[10px] text-gray-400 mt-1 flex items-center gap-1">
                                                <span>🔑</span> <%= video.keyword %>
                                            </div>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                
                <div class="bg-gray-50 px-6 py-3 border-t border-gray-100 text-center">
                    <p class="text-[10px] text-gray-400">يتم تحديث الإحصائيات في الوقت الفعلي ⚡</p>
                </div>
            </div>

        <% } else { %>
            <div class="text-center py-16 bg-white rounded-3xl border border-dashed border-gray-200 group hover:border-pink-300 transition duration-300">
                <div class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition duration-300">
                    <span class="text-4xl grayscale group-hover:grayscale-0 transition">📉</span>
                </div>
                <h3 class="font-bold text-gray-800 text-lg mb-1">لا توجد حملات نشطة</h3>
                <p class="text-gray-400 text-sm mb-6 max-w-xs mx-auto">ابدأ الآن وأطلق حملتك الأولى لزيادة المشاهدات والزيارات.</p>
                <button onclick="document.getElementById('campaignForm').scrollIntoView({behavior: 'smooth'})" 
                        class="text-pink-600 font-bold text-sm hover:underline hover:text-pink-700 transition">
                    + إنشاء حملة جديدة
                </button>
            </div>
        <% } %>
    </div>
