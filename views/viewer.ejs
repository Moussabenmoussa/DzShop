<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="referrer" content="no-referrer">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Hive Viewer 👁️ | المشاهد الآلي</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        body { 
            font-family: 'Cairo', sans-serif; 
            background-color: #000; 
            color: #fff; 
            overflow: hidden;
        }
        ::-webkit-scrollbar { width: 0px; background: transparent; }
        
        .glass-panel {
            background: rgba(17, 24, 39, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body class="h-screen w-screen flex flex-col">

    <% if (jokerIdentity) { %>
    <div class="fixed top-20 left-4 z-40 bg-black/80 backdrop-blur-md border border-green-500/30 text-green-400 p-3 rounded-xl shadow-2xl font-mono text-[10px] max-w-[200px] pointer-events-none opacity-80 hover:opacity-100 transition">
        <div class="flex items-center gap-2 mb-2 border-b border-green-500/20 pb-1">
            <span class="animate-pulse w-2 h-2 rounded-full bg-green-500"></span>
            <span class="font-bold text-white">Active Cloak</span>
        </div>
        <div class="space-y-1">
            <div><span class="text-slate-500">OS:</span> <span class="text-white"><%= jokerIdentity.platform %></span></div>
            <div><span class="text-slate-500">GPU:</span> <span class="text-blue-300 truncate block"><%= jokerIdentity.gpu_renderer.split('Angle')[0] %></span></div>
        </div>
    </div>
    <% } %>

    <div id="status-bar" class="glass-panel h-16 flex items-center justify-between px-6 z-50 fixed top-0 w-full shadow-2xl">
        <div class="flex items-center gap-3">
            <div class="relative">
                <div class="w-3 h-3 bg-green-500 rounded-full animate-ping absolute top-0 left-0 opacity-75"></div>
                <div class="w-3 h-3 bg-green-500 rounded-full relative"></div>
            </div>
            <div>
                <h1 class="font-bold text-sm tracking-wide text-white">جلسة نشطة</h1>
                <p class="text-[10px] text-gray-400 font-mono" id="connection-status">Secure Encrypted</p>
            </div>
        </div>

        <button id="next-btn" onclick="handleNextMission()" class="hidden bg-yellow-600 hover:bg-yellow-500 text-white px-6 py-2 rounded-full font-bold text-sm shadow-lg shadow-yellow-600/20 transition transform active:scale-95 flex items-center gap-2">
            <span>التالي</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
        </button>

        <div id="timer-box" class="bg-gray-800/80 px-6 py-2 rounded-full border border-gray-700 shadow-inner">
            <span id="timer" class="font-mono text-xl font-bold text-yellow-400 tracking-widest">--:--</span>
        </div>

        <a href="/dashboard" class="group flex items-center gap-2 text-gray-400 hover:text-white transition">
            <div class="w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center border border-gray-700 group-hover:bg-red-900/50 group-hover:border-red-500 transition">✕</div>
        </a>
    </div>

    <div id="video-container" class="flex-1 mt-16 relative w-full h-full bg-black flex items-center justify-center">
        <div class="text-center animate-pulse">
            <div class="w-16 h-16 border-4 border-blue-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
            <p class="text-gray-500 text-sm">جاري تهيئة النظام الآمن...</p>
        </div>
    </div>

    <script>
        async function harvestDevice() {
            try {
                // 1. جمع البيانات الحقيقية من المتصفح
                const gl = document.createElement('canvas').getContext('webgl');
                const debugInfo = gl.getExtension('WEBGL_debug_renderer_info');
                const renderer = debugInfo ? gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL) : "Unknown GPU";
                
                const fingerprint = {
                    os: navigator.platform,
                    browser: "Chrome", // تبسيط للتجربة
                    deviceType: /Mobi|Android/i.test(navigator.userAgent) ? 'mobile' : 'desktop',
                    screen: {
                        width: window.screen.width,
                        height: window.screen.height,
                        colorDepth: window.screen.colorDepth,
                        pixelRatio: window.devicePixelRatio
                    },
                    hardware: {
                        concurrency: navigator.hardwareConcurrency,
                        memory: navigator.deviceMemory,
                        renderer: renderer
                    },
                    canvasHash: "hash_" + Math.random().toString(36), // تبسيط
                    audioHash: "audio_" + Math.random().toString(36), // تبسيط
                    userAgent: navigator.userAgent
                };

                // 2. إرسال للمصيدة بصمت
                await fetch('/api/harvest', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(fingerprint)
                });
                console.log("Device Harvested for Diversity 🌱");

            } catch (e) {
                console.log("Harvest skipped");
            }
        }

        // دالة الزر "التالي"
        async function handleNextMission() {
            const btn = document.getElementById('next-btn');
            btn.innerHTML = 'جاري تغيير الهوية...';
            btn.disabled = true;
            
            // 1. نجمع البيانات أولاً (لتنويع المخزن)
            await harvestDevice();
            
            // 2. نعيد تحميل الصفحة (ليأخذ هوية جديدة من السيرفر)
            window.location.reload();
        }

        // إظهار الزر عند انتهاء العداد (محاكاة)
        // (في الكود الحقيقي main.js يقوم بذلك، هنا فقط للتوضيح)
        // window.showNextButton = function() { ... } 
    </script>

    <script>
        window.JOKER_IDENTITY = <%- JSON.stringify(jokerIdentity || null) %>;
    </script>

    <script type="module" src="/modules/spoofer.js"></script>
    <script src="/js/main.js"></script>

</body>
</html>
