<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
<meta name="referrer" content="no-referrer">


    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Hive Viewer 👁️ | المشاهد الآلي</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        body { 
            font-family: 'Cairo', sans-serif; 
            background-color: #000; 
            color: #fff; 
            overflow: hidden; /* منع التمرير في الصفحة الرئيسية */
        }
        /* إخفاء شريط التمرير للمتصفح لجمالية أكثر */
        ::-webkit-scrollbar { width: 0px; background: transparent; }
        
        .glass-panel {
            background: rgba(17, 24, 39, 0.7);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body class="h-screen w-screen flex flex-col">

    <div id="status-bar" class="glass-panel h-16 flex items-center justify-between px-6 z-50 fixed top-0 w-full shadow-2xl">
        
        <div class="flex items-center gap-3">
            <div class="relative">
                <div class="w-3 h-3 bg-green-500 rounded-full animate-ping absolute top-0 left-0 opacity-75"></div>
                <div class="w-3 h-3 bg-green-500 rounded-full relative"></div>
            </div>
            <div>
                <h1 class="font-bold text-sm tracking-wide text-white">جلسة نشطة</h1>
                <p class="text-[10px] text-gray-400 font-mono" id="connection-status">Secure Connection encrypted</p>
            </div>
        </div>

        <div class="bg-gray-800/80 px-6 py-2 rounded-full border border-gray-700 shadow-inner">
            <span id="timer" class="font-mono text-xl font-bold text-yellow-400 tracking-widest">--:--</span>
        </div>

        <a href="/dashboard" class="group flex items-center gap-2 text-gray-400 hover:text-white transition">
            <span class="text-xs font-bold hidden sm:block group-hover:-translate-x-1 transition-transform">خروج</span>
            <div class="w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center border border-gray-700 group-hover:bg-red-900/50 group-hover:border-red-500 transition">
                ✕
            </div>
        </a>
    </div>

    <div id="video-container" class="flex-1 mt-16 relative w-full h-full bg-black flex items-center justify-center">
        <div class="text-center animate-pulse">
            <div class="w-16 h-16 border-4 border-blue-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
            <p class="text-gray-500 text-sm">جاري تهيئة النظام الآمن...</p>
        </div>
    </div>

    <div id="thunder-modal" class="fixed inset-0 bg-black/90 z-[9999] hidden flex items-center justify-center backdrop-blur-md">
        <div class="bg-gray-900 border border-red-500/50 p-8 rounded-3xl shadow-[0_0_50px_rgba(220,38,38,0.2)] max-w-sm w-full text-center relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-red-600 to-orange-600"></div>
            
            <div class="w-16 h-16 bg-red-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-3xl">⚠️</span>
            </div>

            <h2 id="thunder-title" class="text-2xl font-bold text-white mb-2">تحذير أمني</h2>
            <p id="thunder-msg" class="text-gray-300 mb-6 text-sm leading-relaxed">تم اكتشاف سلوك غير طبيعي.</p>
            
            <button id="thunder-btn" class="w-full py-3.5 px-6 rounded-xl font-bold text-white bg-gradient-to-r from-red-600 to-red-800 hover:from-red-500 hover:to-red-700 transition shadow-lg active:scale-95">
                موافق
            </button>
        </div>
    </div>

    <div id="toast-container" class="fixed top-24 left-1/2 transform -translate-x-1/2 z-[100] flex flex-col gap-2 w-full max-w-sm px-4 pointer-events-none"></div>
    
    <audio id="sound-success" src="https://assets.mixkit.co/active_storage/sfx/2000/2000-preview.mp3" preload="auto"></audio>
    <audio id="sound-error" src="https://assets.mixkit.co/active_storage/sfx/944/944-preview.mp3" preload="auto"></audio>
    <audio id="sound-click" src="https://assets.mixkit.co/active_storage/sfx/2571/2571-preview.mp3" preload="auto"></audio>

    <script src="/modules/humanizer.js"></script>

    <script src="/modules/spoofer.js"></script>

    <script src="/js/main.js"></script>

</body>
</html>
