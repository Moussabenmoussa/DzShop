
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="referrer" content="no-referrer">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Mission Control | غرفة العمليات</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        body { 
            font-family: 'Cairo', sans-serif; 
            background-color: #0f172a; /* Slate-900 */
            color: #e2e8f0; 
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: 100vh;
        }
        .mono { font-family: 'JetBrains Mono', monospace; }
        
        .btn-glow { box-shadow: 0 0 15px rgba(59, 130, 246, 0.5); }
        .btn-glow:hover { box-shadow: 0 0 25px rgba(59, 130, 246, 0.8); }

        .cursor-blink { animation: blink 1s step-end infinite; }
        @keyframes blink { 50% { opacity: 0; } }
    </style>
</head>
<body>

    <audio id="sound-success" src="https://assets.mixkit.co/active_storage/sfx/2000/2000-preview.mp3" preload="auto"></audio>
    <audio id="sound-error" src="https://assets.mixkit.co/active_storage/sfx/944/944-preview.mp3" preload="auto"></audio>
    <audio id="sound-click" src="https://assets.mixkit.co/active_storage/sfx/2568/2568-preview.mp3" preload="auto"></audio>

    <div id="toast-container" class="fixed top-24 left-1/2 transform -translate-x-1/2 z-[100] flex flex-col gap-2 w-full max-w-sm px-4 pointer-events-none"></div>

    <div class="h-16 flex items-center justify-between px-6 border-b border-slate-800 bg-slate-900/80 backdrop-blur-md z-50">
        <div class="flex items-center gap-3">
            <span class="text-xs font-bold text-slate-500 uppercase">TIME REMAINING</span>
            <div class="bg-black/50 px-4 py-1 rounded border border-slate-700">
                <span id="timer" class="mono text-xl font-bold text-yellow-500 tracking-widest">--:--</span>
            </div>
        </div>

        <a href="/dashboard" class="flex items-center gap-2 text-slate-500 hover:text-red-400 transition">
            <span class="text-xs font-bold">ABORT</span>
            <div class="w-8 h-8 rounded bg-slate-800 flex items-center justify-center border border-slate-700 hover:border-red-500">✕</div>
        </a>
    </div>

    <div class="flex-1 flex flex-col items-center justify-center relative p-6 gap-8">
        
        <div class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20 pointer-events-none"></div>

        <div class="w-full max-w-2xl bg-slate-900 border border-slate-700 rounded-2xl p-6 shadow-2xl relative overflow-hidden group hover:border-blue-500/50 transition duration-500">
            <div class="flex justify-between items-center mb-4 border-b border-slate-800 pb-2">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
                    <span class="text-[10px] font-bold text-slate-400 tracking-widest uppercase">Active Cloak</span>
                </div>
                <span class="mono text-[10px] text-slate-600">ID: <%= Math.floor(Math.random()*100000) %></span>
            </div>

            <div class="flex items-center gap-6">
                <div id="device-icon" class="text-slate-600">
                    <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                </div>
                
                <div class="flex-1 space-y-1 mono text-sm">
                    <div class="flex gap-2">
                        <span class="text-slate-500 w-20">SYSTEM:</span>
                        <span id="type-os" class="text-blue-400 font-bold">Initializing...</span>
                    </div>
                    <div class="flex gap-2">
                        <span class="text-slate-500 w-20">GPU:</span>
                        <span id="type-gpu" class="text-purple-400">Scanning...</span>
                    </div>
                    <div class="flex gap-2 pt-2">
                        <span class="text-slate-500 w-20">STATUS:</span>
                        <span class="text-green-500 font-bold text-xs uppercase bg-green-500/10 px-2 py-0.5 rounded">Secure Tunnel</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="w-full max-w-2xl bg-blue-900/10 border border-blue-500/30 rounded-2xl p-6 text-center relative">
            <h2 class="text-slate-400 text-xs font-bold uppercase tracking-widest mb-4">Current Mission Target</h2>
            
            <% if (video && video.visitType === 'search') { %>
                <div class="mb-6">
                    <p class="text-slate-500 text-sm mb-1">Search Keyword:</p>
                    <div class="bg-black/40 border border-slate-600 rounded-lg p-3 flex items-center justify-between max-w-md mx-auto">
                        <code class="text-xl text-white font-bold select-all" id="mission-keyword"><%= video.keyword %></code>
                        <button onclick="copyKeyword()" class="text-xs bg-slate-700 hover:bg-slate-600 text-white px-2 py-1 rounded transition">Copy</button>
                    </div>
                </div>
            <% } else { %>
                 <div class="mb-6">
                    <p class="text-slate-500 text-sm mb-1">Direct Link Access:</p>
                    <p class="text-lg text-white font-bold truncate max-w-md mx-auto"><%= video ? video.url : 'Loading...' %></p>
                </div>
            <% } %>

            <button onclick="executeMission()" class="btn-glow bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 px-10 rounded-xl text-lg flex items-center justify-center gap-3 mx-auto transition-all transform hover:scale-105 active:scale-95 w-full max-w-xs">
                <span>OPEN TARGET</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </button>
            
            <p class="text-[10px] text-slate-500 mt-3">Clicking will open a secure popup window. Keep this page open.</p>
        </div>

    </div>

    <script>
        window.JOKER_IDENTITY = <%- JSON.stringify(jokerIdentity || null) %>;
        const TARGET_URL = "<%= video ? video.url : '#' %>"; 

        document.addEventListener("DOMContentLoaded", () => {
            if (!window.JOKER_IDENTITY) return;
            
            const osEl = document.getElementById('type-os');
            const gpuEl = document.getElementById('type-gpu');
            const iconEl = document.getElementById('device-icon');

            const platform = window.JOKER_IDENTITY.platform || "PC";
            if(platform.includes('iPhone') || platform.includes('Android')) {
                iconEl.innerHTML = `<svg class="w-16 h-16 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>`;
            } else {
                iconEl.innerHTML = `<svg class="w-16 h-16 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>`;
            }

            function type(el, text) {
                el.textContent = "";
                let i = 0;
                let int = setInterval(() => {
                    el.textContent += text.charAt(i);
                    i++;
                    if(i >= text.length) clearInterval(int);
                }, 30);
            }
            
            setTimeout(() => type(osEl, window.JOKER_IDENTITY.platform), 500);
            setTimeout(() => type(gpuEl, (window.JOKER_IDENTITY.gpu_renderer || "").split('Angle')[0]), 1000);
        });

        function executeMission() {
            document.getElementById('sound-click').play().catch(()=>{});

            const w = 1000;
            const h = 800;
            const left = (screen.width/2)-(w/2);
            const top = (screen.height/2)-(h/2);

            window.open(TARGET_URL, 'MissionTarget', `width=${w},height=${h},top=${top},left=${left},scrollbars=yes,resizable=yes`);
        }

        function copyKeyword() {
            const text = document.getElementById('mission-keyword').innerText;
            navigator.clipboard.writeText(text);
            alert("تم نسخ الكلمة! الصقها في جوجل في النافذة الجديدة.");
        }
    </script>

    <script type="module" src="/modules/spoofer.js"></script>
    <script src="/js/main.js"></script>

</body>
</html>
