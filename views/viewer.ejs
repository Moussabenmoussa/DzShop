<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Hive Viewer 👁️</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* إخفاء شريط التمرير للتركيز */
        body { overflow: hidden; background: #000; color: #fff; }
        #safe-frame { width: 100%; height: 100vh; border: none; }
    </style>
</head>
<body>





    
    <!-- 🔔 حاوية الإشعارات -->
    <div id="toast-container" class="fixed top-20 left-1/2 transform -translate-x-1/2 z-[100] flex flex-col gap-2 w-full max-w-sm px-4 pointer-events-none"></div>
    
    <!-- 🔊 ملفات الصوت -->
    <audio id="sound-success" src="https://assets.mixkit.co/active_storage/sfx/2000/2000-preview.mp3" preload="auto"></audio>
    <audio id="sound-error" src="https://assets.mixkit.co/active_storage/sfx/944/944-preview.mp3" preload="auto"></audio>
    <audio id="sound-click" src="https://assets.mixkit.co/active_storage/sfx/2568/2568-preview.mp3" preload="auto"></audio>
    
    <!-- 🛡️ نافذة نظام الرعد (Modal) -->
    <div id="thunder-modal" class="fixed inset-0 bg-black bg-opacity-90 z-[9999] hidden flex items-center justify-center backdrop-blur-sm">
        <div class="bg-gray-900 border border-red-600 p-8 rounded-2xl shadow-2xl max-w-md w-full text-center">
            <h2 id="thunder-title" class="text-2xl font-bold text-white mb-2">تحذير</h2>
            <p id="thunder-msg" class="text-gray-300 mb-6 text-sm">رسالة النظام</p>
            <button id="thunder-btn" class="w-full py-3 px-6 rounded-xl font-bold text-white bg-red-600">موافق</button>
        </div>
    </div>

    


    <!-- الشريط العلوي (العداد) -->
    <div id="status-bar" class="fixed top-0 left-0 w-full bg-gray-900 p-2 flex justify-between items-center z-50 border-b border-gray-700">
        <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-green-500 rounded-full animate-ping"></div>
            <span class="font-bold text-sm">جاري المشاهدة...</span>
        </div>
        <div class="font-mono text-yellow-400 font-bold" id="timer">Loading...</div>
    </div>

    <!-- حاوية الفيديو (التي سنطبق عليها الأسرار) -->
    <div id="video-container" class="mt-10">
        <!-- سيتم حقن الفيديو هنا بواسطة JS -->
        <div class="text-center mt-20 text-gray-500">
            جاري الاتصال بخلية النحل... <br>
            لا تغلق هذه الصفحة.
        </div>
    </div>

    <!-- استدعاء الأسلحة السرية (سننشئها في الدفعة القادمة) -->
    <script src="/modules/spoofer.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
