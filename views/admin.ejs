<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة القيادة | DzMarket Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Tajawal', sans-serif; background: #f3f4f6; }
        .active-tab { background-color: #2563eb; color: white; }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <aside class="w-64 bg-slate-900 text-white flex flex-col shadow-xl">
        <div class="p-6 text-center border-b border-slate-700">
            <h1 class="text-2xl font-bold text-yellow-400">DzMarket 👑</h1>
            <p class="text-xs text-slate-400 mt-1">Admin Control Panel</p>
        </div>
        <nav class="flex-1 p-4 space-y-2">
            <button onclick="switchTab('campaigns')" id="tab-campaigns" class="w-full text-right px-4 py-3 rounded-lg hover:bg-slate-800 transition flex items-center gap-3 active-tab">
                <span>📢</span> مراجعة الحملات
            </button>
            <button onclick="switchTab('finance')" id="tab-finance" class="w-full text-right px-4 py-3 rounded-lg hover:bg-slate-800 transition flex items-center gap-3">
                <span>💰</span> المالية والشحن
            </button>
            <button onclick="switchTab('settings')" id="tab-settings" class="w-full text-right px-4 py-3 rounded-lg hover:bg-slate-800 transition flex items-center gap-3">
                <span>⚙️</span> الإعدادات العامة
            </button>
        </nav>
        <div class="p-4 border-t border-slate-700">
            <a href="/dashboard" class="block text-center bg-slate-800 hover:bg-slate-700 py-2 rounded text-sm">العودة للموقع</a>
        </div>
    </aside>

    <main class="flex-1 overflow-y-auto p-8">
        
        <div id="view-campaigns" class="view-section">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
                <span class="bg-blue-100 text-blue-600 p-2 rounded-lg">📢</span> الحملات المعلقة (Sites)
            </h2>
            <div id="campaigns-list" class="grid gap-4">
                <p class="text-gray-500">جاري التحميل...</p>
            </div>
        </div>

        <div id="view-finance" class="view-section hidden">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
                <span class="bg-green-100 text-green-600 p-2 rounded-lg">💰</span> طلبات الشحن
            </h2>
            <div id="deposits-list" class="grid gap-4">
                <p class="text-gray-500">جاري التحميل...</p>
            </div>
        </div>

        <div id="view-settings" class="view-section hidden">
            <h2 class="text-2xl font-bold mb-6">⚙️ إعدادات الموقع</h2>
            <div class="bg-white p-6 rounded-xl shadow-sm max-w-2xl">
                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-bold mb-1">سعر 1000 نقطة (دج)</label>
                        <input id="set-price" type="number" class="w-full border p-2 rounded">
                    </div>
                    <div>
                        <label class="block text-sm font-bold mb-1">تكلفة الحملة (نقاط)</label>
                        <input id="set-cost" type="number" class="w-full border p-2 rounded">
                    </div>
                </div>
                <div class="mb-4">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input id="set-sale" type="checkbox" class="w-5 h-5 text-blue-600">
                        <span class="font-bold">تفعيل التخفيضات (Sale)</span>
                    </label>
                </div>
                <button onclick="saveSettings()" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">حفظ التغييرات</button>
            </div>
        </div>

    </main>

    <script>
        // التحميل الأولي
        document.addEventListener('DOMContentLoaded', () => {
            loadCampaigns();
            loadDeposits();
            loadSettings();
        });

        function switchTab(tab) {
            document.querySelectorAll('.view-section').forEach(el => el.classList.add('hidden'));
            document.getElementById(`view-${tab}`).classList.remove('hidden');
            
            document.querySelectorAll('aside nav button').forEach(el => el.classList.remove('active-tab'));
            document.getElementById(`tab-${tab}`).classList.add('active-tab');
        }

        // =======================
        // 1. دوال الحملات
        // =======================
        async function loadCampaigns() {
            try {
                const res = await axios.get('/admin/pending-campaigns');
                const list = document.getElementById('campaigns-list');
                list.innerHTML = '';

                if (res.data.campaigns.length === 0) {
                    list.innerHTML = '<div class="bg-white p-6 rounded text-center text-gray-500">لا توجد حملات معلقة 🎉</div>';
                    return;
                }

                res.data.campaigns.forEach(camp => {
                    list.innerHTML += `
                        <div class="bg-white p-4 rounded-xl shadow-sm flex justify-between items-center border-r-4 border-yellow-400">
                            <div>
                                <h3 class="font-bold text-lg">${camp.type === 'website' ? '🌐 موقع' : '📺 فيديو'}</h3>
                                <a href="${camp.url}" target="_blank" class="text-blue-600 hover:underline text-sm truncate block max-w-md">${camp.url}</a>
                                <p class="text-xs text-gray-500 mt-1">المستخدم: ${camp.userId.email} | النقاط: ${camp.targetViews * camp.costPerView}</p>
                            </div>
                            <div class="flex gap-2">
                                <button onclick="campAction('${camp._id}', 'approve')" class="bg-green-100 text-green-700 px-4 py-2 rounded-lg font-bold hover:bg-green-200">✅ قبول</button>
                                <button onclick="campAction('${camp._id}', 'reject')" class="bg-red-100 text-red-700 px-4 py-2 rounded-lg font-bold hover:bg-red-200">❌ رفض</button>
                            </div>
                        </div>
                    `;
                });
            } catch (err) { console.error(err); }
        }

        async function campAction(id, action) {
            if(!confirm('هل أنت متأكد؟')) return;
            await axios.post('/admin/campaign-action', { videoId: id, action });
            loadCampaigns(); // تحديث القائمة
        }

        // =======================
        // 2. دوال المالية
        // =======================
        async function loadDeposits() {
            try {
                const res = await axios.get('/admin/pending-deposits');
                const list = document.getElementById('deposits-list');
                list.innerHTML = '';

                if (res.data.deposits.length === 0) {
                    list.innerHTML = '<div class="bg-white p-6 rounded text-center text-gray-500">لا توجد طلبات شحن جديدة 💸</div>';
                    return;
                }

                res.data.deposits.forEach(dep => {
                    list.innerHTML += `
                        <div class="bg-white p-4 rounded-xl shadow-sm border-r-4 border-green-500">
                            <div class="flex justify-between items-start mb-2">
                                <div>
                                    <span class="font-bold text-lg text-green-700">+${dep.points} نقطة</span>
                                    <span class="text-gray-500 text-sm">(${dep.amount} دج)</span>
                                    <div class="text-xs bg-gray-100 inline-block px-2 py-1 rounded mt-1">${dep.method}</div>
                                </div>
                                <div class="text-left">
                                    <p class="font-bold text-sm">${dep.userId.email}</p>
                                    <p class="text-xs text-gray-400">Transaction ID: ${dep.transactionId}</p>
                                </div>
                            </div>
                            ${dep.proofImage ? `<a href="${dep.proofImage}" target="_blank" class="block bg-gray-50 text-center py-2 text-blue-600 text-sm mb-3 border border-dashed border-gray-300 rounded">📄 مشاهدة الوصل</a>` : ''}
                            
                            <div class="flex gap-2 mt-2">
                                <button onclick="depAction('${dep._id}', 'approve')" class="flex-1 bg-green-600 text-white py-2 rounded-lg font-bold hover:bg-green-700 shadow-lg shadow-green-200">تأكيد الشحن</button>
                                <button onclick="depAction('${dep._id}', 'reject')" class="flex-1 bg-gray-200 text-gray-700 py-2 rounded-lg font-bold hover:bg-gray-300">إلغاء</button>
                            </div>
                        </div>
                    `;
                });
            } catch (err) { console.error(err); }
        }

        async function depAction(id, action) {
            if(!confirm('هل أنت متأكد من العملية؟')) return;
            await axios.post('/admin/deposit-action', { transactionId: id, action });
            loadDeposits();
        }

        // =======================
        // 3. دوال الإعدادات
        // =======================
        async function loadSettings() {
            const res = await axios.get('/admin/settings');
            const s = res.data.settings;
            // يمكنك توسيع هذا الجزء لملء الحقول
            // document.getElementById('set-price').value = s.pointsPrice;
        }

        async function saveSettings() {
            // منطق الحفظ (يمكنك إكماله لاحقاً)
            alert('تم حفظ الإعدادات (تجريبي)');
        }
    </script>
</body>
</html>
