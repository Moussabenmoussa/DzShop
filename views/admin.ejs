<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>.tab-content { display: none; } .tab-content.active { display: block; }</style>
</head>
<body class="bg-slate-950 text-white pb-20 p-4 font-sans">

    <div class="flex gap-2 bg-slate-900 p-2 rounded-xl mb-6">
        <button onclick="openTab('campaigns')" class="flex-1 bg-yellow-600 p-3 rounded-lg font-bold text-sm hover:opacity-90 transition">الحملات</button>
        <button onclick="openTab('users')" class="flex-1 bg-slate-800 p-3 rounded-lg font-bold text-sm hover:opacity-90 transition">المستخدمين</button>
    </div>

    <div id="campaigns" class="tab-content active">
        <div class="flex justify-between items-center mb-4">
            <h2 class="font-bold text-yellow-500 text-lg">مراجعة الحملات</h2>
            <button onclick="loadCampaigns()" class="bg-blue-600 px-4 py-2 rounded-lg text-xs font-bold shadow-lg shadow-blue-500/20 active:scale-95 transition">تحديث القائمة 🔄</button>
        </div>
        
        <div id="campaigns-list" class="space-y-3">
            <p class="text-center text-slate-500 py-10">جاري التحميل...</p>
        </div>
    </div>

    <div id="users" class="tab-content">
        <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800">
            <h2 class="font-bold text-green-500 mb-6 text-lg border-b border-slate-700 pb-2">💰 شحن رصيد يدوي</h2>
            <div class="space-y-4">
                <div>
                    <label class="text-xs text-slate-400 mb-1 block">بريد المستخدم</label>
                    <input id="u-email" type="email" placeholder="user@example.com" class="w-full bg-slate-950 border border-slate-700 p-3 rounded-xl text-white outline-none focus:border-green-500 transition">
                </div>
                <div>
                    <label class="text-xs text-slate-400 mb-1 block">عدد النقاط</label>
                    <input id="u-points" type="number" placeholder="1000" class="w-full bg-slate-950 border border-slate-700 p-3 rounded-xl text-white outline-none focus:border-green-500 transition">
                </div>
                <button onclick="modPoints()" class="w-full bg-green-600 py-4 rounded-xl font-bold text-white shadow-lg shadow-green-600/20 hover:bg-green-500 active:scale-95 transition">تنفيذ العملية</button>
            </div>
        </div>
    </div>

    <script>
        // التبديل بين التبويبات
        function openTab(id) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.getElementById(id).classList.add('active');
        }

        // دالة جلب الحملات (محمية ضد الأخطاء)
        async function loadCampaigns() {
            const list = document.getElementById('campaigns-list');
            list.innerHTML = '<p class="text-center text-slate-500 animate-pulse">جاري الاتصال بالسيرفر...</p>';
            
            try {
                const res = await fetch('/admin/pending-campaigns');
                const data = await res.json();

                if (!data.success || data.campaigns.length === 0) {
                    list.innerHTML = `
                        <div class="text-center py-10">
                            <div class="text-4xl mb-2">✅</div>
                            <p class="text-slate-500">لا توجد حملات بانتظار المراجعة</p>
                        </div>`;
                    return;
                }

                // تعبئة القائمة
                list.innerHTML = data.campaigns.map(c => {
                    // حماية البيانات: إذا كان المستخدم محذوفاً نعرض "غير معروف" بدلاً من تكسير الصفحة
                    const userEmail = c.userId ? c.userId.email : '<span class="text-red-500">مستخدم محذوف</span>';
                    const title = c.title || c.url || 'بدون عنوان';
                    const typeIcon = c.type === 'video' ? '📺' : '🌐';
                    const statusColor = c.status === 'Rejected' ? 'text-red-500' : 'text-yellow-500';

                    return `
                    <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 shadow-sm hover:border-slate-600 transition">
                        <div class="flex justify-between items-start mb-3">
                            <div class="overflow-hidden w-full">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-xs font-bold ${statusColor} bg-slate-900 px-2 py-1 rounded">${typeIcon} ${c.status || 'Pending'}</span>
                                    <span class="text-[10px] text-slate-400 bg-slate-900 px-2 py-1 rounded">${c.targetViews} مشاهدة</span>
                                </div>
                                <a href="${c.url}" target="_blank" class="text-sm font-bold text-blue-400 hover:text-blue-300 underline truncate block w-full" dir="ltr">${title}</a>
                                <p class="text-[10px] text-slate-400 mt-2 flex items-center gap-1">👤 ${userEmail}</p>
                            </div>
                        </div>
                        <div class="flex gap-3 mt-4">
                            <button onclick="doAction('${c._id}', 'approve')" class="flex-1 bg-green-600 hover:bg-green-500 py-2 rounded-lg text-xs font-bold shadow-md transition">✅ قبول</button>
                            <button onclick="doAction('${c._id}', 'reject')" class="flex-1 bg-red-900/50 hover:bg-red-900 text-red-400 border border-red-900 py-2 rounded-lg text-xs font-bold transition">❌ رفض</button>
                        </div>
                    </div>
                    `;
                }).join('');

            } catch (err) {
                list.innerHTML = `<p class="text-red-500 text-center py-10 border border-red-900 bg-red-900/10 rounded-xl">حدث خطأ في العرض: ${err.message}</p>`;
            }
        }

        // دالة القبول والرفض
        async function doAction(id, action) {
            if(!confirm(action === 'approve' ? 'هل أنت متأكد من قبول الحملة؟' : 'هل تريد رفض هذه الحملة؟')) return;
            
            try {
                const res = await fetch('/admin/campaign-action', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ videoId: id, action })
                });
                const d = await res.json();
                // بدلاً من التنبيه المزعج، نعيد تحميل القائمة فقط
                if(d.success) {
                    loadCampaigns(); 
                } else {
                    alert(d.message);
                }
            } catch(e) {
                alert("خطأ في الاتصال");
            }
        }

        // دالة شحن النقاط
        async function modPoints() {
            const btn = event.target;
            const originalText = btn.innerText;
            btn.innerText = "جاري التنفيذ...";
            btn.disabled = true;

            try {
                const res = await fetch('/admin/modify-user-points', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        email: document.getElementById('u-email').value,
                        amount: document.getElementById('u-points').value,
                        action: 'add'
                    })
                });
                const d = await res.json();
                alert(d.message);
            } catch(e) {
                alert("خطأ");
            } finally {
                btn.innerText = originalText;
                btn.disabled = false;
            }
        }

        // التشغيل التلقائي عند الفتح
        window.onload = loadCampaigns;
    </script>
</body>
</html>
