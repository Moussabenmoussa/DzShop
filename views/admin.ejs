<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم الجوكر</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Cairo', sans-serif; background: #0f172a; color: white; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .tab-btn.active { border-bottom: 3px solid #eab308; color: #eab308; }
    </style>
</head>

<body class="bg-slate-950 pb-20">

    <nav class="bg-slate-900 border-b border-slate-800 p-4 sticky top-0 z-50">
        <div class="flex justify-between items-center max-w-6xl mx-auto">
            <h1 class="text-xl font-bold text-yellow-500">مركز التحكم 🃏</h1>
        </div>
    </nav>

    <div class="flex bg-slate-900 border-b border-slate-800 sticky top-[65px] z-40 overflow-x-auto">
        <button onclick="openTab('campaigns')" class="tab-btn active flex-1 py-4 text-sm font-bold">الحملات</button>
        <button onclick="openTab('users')" class="tab-btn flex-1 py-4 text-sm font-bold">المستخدمين</button>
        <button onclick="openTab('gateways')" class="tab-btn flex-1 py-4 text-sm font-bold">بوابة PayPal</button>
    </div>

    <main class="max-w-6xl mx-auto p-4">
        <section id="campaigns" class="tab-content active space-y-4">
            <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800">
                <h2 class="text-lg font-bold mb-4">طلبات المراجعة</h2>
                <div id="campaigns-list" class="text-slate-500 italic text-center py-10 underline">جاري التحميل...</div>
            </div>
        </section>

        <section id="users" class="tab-content space-y-4">
            <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800">
                <h3 class="font-bold text-yellow-500 mb-4 text-center underline">إضافة رصيد يدوي للمستخدم</h3>
                <div class="space-y-3">
                    <input type="email" id="target-email" placeholder="إيميل المستخدم المستهدف" class="w-full bg-slate-800 p-3 rounded-xl border-none text-white">
                    <input type="number" id="points-amount" placeholder="عدد النقاط المراد إضافتها" class="w-full bg-slate-800 p-3 rounded-xl border-none text-white">
                    <button onclick="addPoints()" class="w-full bg-yellow-600 py-3 rounded-xl font-bold hover:bg-yellow-700">تأكيد شحن الحساب</button>
                </div>
            </div>
        </section>

        <section id="gateways" class="tab-content space-y-4">
            <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800">
                <h3 class="font-bold text-blue-400 mb-6 underline">إعدادات بوابة PayPal API</h3>
                <div class="space-y-4">
                    <div>
                        <label class="text-xs text-slate-400 block mb-1">PayPal Client ID</label>
                        <input type="text" id="paypal-client" class="w-full bg-slate-800 p-3 rounded-xl text-xs font-mono border-none text-white" placeholder="Client ID من حساب بايبال">
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 block mb-1">PayPal Secret Key</label>
                        <input type="password" id="paypal-secret" class="w-full bg-slate-800 p-3 rounded-xl text-xs font-mono border-none text-white" placeholder="Secret Key من حساب بايبال">
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-xs text-slate-400 block mb-1">الوضع</label>
                            <select id="paypal-mode" class="w-full bg-slate-800 p-3 rounded-xl text-sm border-none text-white">
                                <option value="sandbox">Sandbox (تجريبي)</option>
                                <option value="live">Live (حقيقي)</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-xs text-slate-400 block mb-1">سعر الصرف (1$ = كم دج؟)</label>
                            <input type="number" id="exchange-rate" class="w-full bg-slate-800 p-3 rounded-xl text-sm border-none text-white" value="200">
                        </div>
                    </div>
                    <button onclick="savePaypal()" class="w-full bg-blue-600 py-4 rounded-xl font-bold mt-4 hover:bg-blue-700">حفظ وتفعيل بوابة الدفع</button>
                </div>
            </div>
        </section>
    </main>

    <script>
        function openTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            event.currentTarget.classList.add('active');
        }

        async function savePaypal() {
            const res = await fetch('/admin/update-paypal', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    clientId: document.getElementById('paypal-client').value,
                    secret: document.getElementById('paypal-secret').value,
                    mode: document.getElementById('paypal-mode').value,
                    exchangeRate: document.getElementById('exchange-rate').value
                })
            });
            const data = await res.json();
            alert(data.message);
        }

        async function addPoints() {
            const res = await fetch('/admin/modify-user-points', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    email: document.getElementById('target-email').value,
                    amount: document.getElementById('points-amount').value,
                    action: 'add'
                })
            });
            const data = await res.json();
            alert(data.message);
        }



async function loadCampaigns() {
    const res = await fetch('/admin/pending-campaigns');
    const data = await res.json();
    const list = document.getElementById('campaigns-list');
    
    if (data.campaigns.length === 0) {
        list.innerHTML = "لا توجد حملات بانتظار المراجعة حالياً.";
        return;
    }

    list.innerHTML = data.campaigns.map(v => `
        <div class="bg-slate-800 p-4 rounded-xl flex justify-between items-center border border-slate-700">
            <div>
                <p class="text-xs text-yellow-500 font-bold">${v.type === 'video' ? '📹 فيديو' : '🌐 موقع'}</p>
                <a href="${v.url}" target="_blank" class="text-sm underline block mb-1">${v.title || 'رابط الحملة'}</a>
                <p class="text-[10px] text-slate-400">بواسطة: ${v.userId.email}</p>
            </div>
            <div class="flex gap-2">
                <button onclick="campaignAction('${v._id}', 'approve')" class="bg-green-600 px-3 py-1 rounded text-xs">قبول</button>
                <button onclick="campaignAction('${v._id}', 'reject')" class="bg-red-600 px-3 py-1 rounded text-xs">رفض</button>
            </div>
        </div>
    `).join('');
}

async function campaignAction(videoId, action) {
    const res = await fetch('/admin/campaign-action', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ videoId, action })
    });
    const data = await res.json();
    alert(data.message);
    loadCampaigns();
}

// تشغيل جلب الحملات تلقائياً عند فتح الصفحة
window.onload = loadCampaigns;





    </script>
</body>
</html>
