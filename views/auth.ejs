

<div class="max-w-md mx-auto bg-white p-8 rounded-xl shadow-md mt-10">
    <h2 class="text-2xl font-bold text-center mb-6">مرحباً بك في خلية النحل 🐝</h2>

    <!-- Login -->
    <form action="/login" method="POST" class="space-y-4">
        <h3 class="border-b pb-2 font-bold">تسجيل الدخول</h3>
        <input type="email" name="email" placeholder="البريد الإلكتروني" required class="w-full p-3 border rounded bg-gray-50">
        <input type="password" name="password" placeholder="كلمة المرور" required class="w-full p-3 border rounded bg-gray-50">
        <button class="w-full bg-pink-600 text-white py-2 rounded hover:bg-pink-700 font-bold">دخول</button>
    </form>

    <div class="my-8 text-center text-gray-400">- أو -</div>

    <!-- Register -->
    <form action="/register" method="POST" class="space-y-4">
        <h3 class="border-b pb-2 font-bold">إنشاء حساب جديد</h3>
        <input type="text" name="name" placeholder="الاسم" required class="w-full p-3 border rounded bg-gray-50">
        <input type="email" name="email" placeholder="البريد الإلكتروني" required class="w-full p-3 border rounded bg-gray-50">
        <input type="password" name="password" placeholder="كلمة المرور" required class="w-full p-3 border rounded bg-gray-50">
        <button class="w-full bg-gray-800 text-white py-2 rounded hover:bg-gray-900 font-bold">انضم للخلية</button>
    </form>
</div>
